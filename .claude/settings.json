{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go mod tidy)",
      "Bash(go generate:*)",
      "Bash(gofmt:*)",
      "Bash(golangci-lint run:*)",
      "Bash(sqlc generate)",
      "Bash(sqlc vet)",
      "Bash(goose status:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.p8)"
    ]
  }
}
