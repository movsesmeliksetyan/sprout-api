# Copy to .env for local development. Real environment variables win over this file.

# dev | staging | prod
ENV=dev
# debug | info | warn | error (default info)
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://sprout:sprout@localhost:5432/sprout?sslmode=disable

# Tenant hostname without scheme, and the API identifier configured in Auth0.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.sprout.local

# Object storage. These values match a local MinIO; leave S3_ENDPOINT empty on AWS.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sprout
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# LLM_PROVIDER is groq (v1) or anthropic; LLM_API_KEY is that provider's key.
# It may stay empty when ENV=dev; it is required in staging and prod.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL_TEXT=qwen/qwen3.8-27b
LLM_MODEL_VISION=qwen/qwen3.8-27b
# Merchants per categorisation call, 1-50 (default 50). Groq's free tier allows
# 1,000 output tokens a minute, about 15 merchants; lower it to fit your tier.
LLM_CATEGORIZE_BATCH=15

# Apple push. May stay empty when ENV=dev (set all four or none); required in
# staging and prod. APNS_KEY_PATH is the path to the .p8 key file.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
