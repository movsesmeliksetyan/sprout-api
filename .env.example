# Copy to .env for local development. Real environment variables win over this file.

# dev | staging | prod
ENV=dev
# debug | info | warn | error (default info)
LOG_LEVEL=debug
HTTP_ADDR=:8080

DATABASE_URL=postgres://sprout:sprout@localhost:5432/sprout?sslmode=disable

# Tenant hostname without scheme, and the API identifier configured in Auth0.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.sprout.local

# Object storage. These values match a local MinIO; leave S3_ENDPOINT empty on AWS.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sprout
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

# LLM_API_KEY may stay empty when ENV=dev; it is required in staging and prod.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_TEXT=claude-sonnet-5-5
LLM_MODEL_VISION=claude-sonnet-5-5

# Apple push. May stay empty when ENV=dev (set all four or none); required in
# staging and prod. APNS_KEY_PATH is the path to the .p8 key file.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=
